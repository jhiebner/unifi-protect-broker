# ===== APPLICATION =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ===== DATABASE =====
# PostgreSQL Connection
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=protect_broker;Username=broker_user;Password=dev_password_change_in_production

# Default credentials (CHANGE IN PRODUCTION!)
POSTGRES_DB=protect_broker
POSTGRES_USER=broker_user
POSTGRES_PASSWORD=dev_password_change_in_production

# ===== JWT AUTHENTICATION =====
# Minimum 32 characters - change immediately in production!
Jwt__Key=your-super-secret-key-that-is-at-least-32-chars-long-change-this
Jwt__Issuer=ProtectBroker
Jwt__Audience=ProtectBroker
Jwt__ExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# ===== UNIFI PROTECT INTEGRATION =====
UnifiProtect__Host=192.168.1.100
UnifiProtect__Port=443
UnifiProtect__Username=admin
UnifiProtect__Password=change_me_to_your_protect_password
UnifiProtect__VerifySsl=false
UnifiProtect__ReconnectIntervalSeconds=30
UnifiProtect__HealthCheckIntervalSeconds=60

# ===== SMTP (EMAIL NOTIFICATIONS) =====
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__UseTls=true
Smtp__Username=your-email@gmail.com
Smtp__Password=your-app-password
Smtp__FromAddress=noreply@protectbroker.local
Smtp__FromName=Protect Broker

# ===== SMS (OPTIONAL) =====
# Twilio configuration
Twilio__AccountSid=your_account_sid
Twilio__AuthToken=your_auth_token
Twilio__FromNumber=+1234567890

# ===== LOGGING =====
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Serilog__MinimumLevel=Information
Serilog__WriteTo__0__Name=Console
Serilog__WriteTo__1__Name=File
Serilog__WriteTo__1__Args__path=/app/logs/protect-broker-.txt
Serilog__WriteTo__1__Args__rollingInterval=Day

# ===== API SETTINGS =====
Api__Cors__AllowedOrigins=http://localhost:5173,http://localhost:3000
Api__RateLimit__Enabled=true
Api__RateLimit__RequestsPerMinute=60

# ===== FEATURE FLAGS =====
Features__EnableNotifications=true
Features__EnableRules=true
Features__EnableBackup=true
Features__EnableScheduledJobs=true
